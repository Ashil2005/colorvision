# Provide your AI API Key here
AI_API_KEY=YOUR_API_KEY_HERE

# API URL for the AI provider. Defaults to OpenRouter but you can change it.
AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Model to use. Examples: meta-llama/llama-3-8b-instruct:free, mistralai/mistral-7b-instruct:free, etc.
AI_MODEL=meta-llama/llama-3-8b-instruct:free

# Port for the backend server
PORT=3000
